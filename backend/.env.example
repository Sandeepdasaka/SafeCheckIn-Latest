# Copy to .env and fill in real values. Never commit the real .env file.

# MongoDB connection string. Must be the SAME database the ai-agent service
# points at (see ai-agent/.env.example).
MONGODB_URI=mongodb://localhost:27017/safecheckin

# Required. Must be at least 32 characters - the server refuses to start
# otherwise. Generate one with: openssl rand -hex 32
# Must be the EXACT SAME value used in ai-agent/.env.
JWT_SECRET=

# Optional.
JWT_EXPIRES_IN=7d

# Optional, defaults to 5000.
PORT=5000

# Comma-separated list of frontend origins allowed to call this API from a
# browser. Required for the receptionist/police apps to work - without it,
# every browser request is blocked by CORS.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082

# development | production
NODE_ENV=development
