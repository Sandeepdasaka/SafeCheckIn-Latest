# Copy to .env and fill in real values. Never commit the real .env file.

# Required. Must point at the SAME MongoDB database as backend/.env's
# MONGODB_URI - this service reads collections the Node backend creates.
MONGODB_URI=mongodb://localhost:27017/safecheckin

# Optional, defaults to "safecheckin".
MONGODB_DB_NAME=safecheckin

# Required. Must be the EXACT SAME value as backend/.env's JWT_SECRET - this
# service decodes tokens the Node backend issued. If they don't match,
# every request gets a 401.
JWT_SECRET=

# Optional, defaults to HS256.
JWT_ALGORITHM=HS256

# Required. API key from https://build.nvidia.com - the agent calls
# NVIDIA's OpenAI-compatible endpoint for the LLM.
NVIDIA_API_KEY=

# Optional, defaults to meta/llama-3.1-70b-instruct.
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Optional, defaults to http://localhost:5000. Used when building any
# backend-hosted URLs returned to a client.
BACKEND_URL=http://localhost:5000

# Optional, defaults to 8000.
PORT=8000

# development | production
ENVIRONMENT=development

# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082
